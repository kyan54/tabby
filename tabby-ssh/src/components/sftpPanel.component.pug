.header
    input.form-control.flex-grow-1.w-0(
        *ngIf='editingPath !== null',
        type='text',
        autofocus,
        (keydown.enter)='confirmPath()',
        (keydown.esc)='editingPath = null',
        (blur)='editingPath = null',
        [(ngModel)]='editingPath'
    )
    .breadcrumb(*ngIf='editingPath === null', (dblclick)='editPath()')
        a.breadcrumb-item.text-decoration-none((click)='navigate("/")') SFTP
        a.breadcrumb-item.text-decoration-none(
            *ngFor='let segment of pathSegments',
            (click)='navigate(segment.path)'
        ) {{segment.name}}

    .breadcrumb-spacer.flex-grow-1.h-100((dblclick)='editPath()')

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='navigate(path)')
        i.fas.fa-sync-alt.me-1
        div(translate) Refresh

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(*ngIf='!showFilter', (click)='showFilter = true')
        i.fas.fa-filter.me-1
        div(translate) Filter

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='openCreateDirectoryModal()')
        i.fas.fa-plus.me-1
        div(translate) Create directory

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='upload()')
        i.fas.fa-upload.me-1
        div(translate) Upload files

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='uploadFolder()')
        i.fas.fa-upload.me-1
        div(translate) Upload folder

    button.btn.btn-link.text-decoration-none((click)='close()') !{require('../../../tabby-core/src/icons/times.svg')}

.sort-bar.px-3.py-1.border-bottom
    button.btn.btn-link.btn-sm(type='button', (click)='sortEditorOpen ? cancelSortEditor() : openSortEditor()', [attr.aria-expanded]='sortEditorOpen', [attr.aria-controls]='sortEditorId')
        i.fas.me-1([class.fa-chevron-right]='!sortEditorOpen', [class.fa-chevron-down]='sortEditorOpen', aria-hidden='true')
        span(translate) Advanced sorting
    .sort-editor([attr.id]='sortEditorId', *ngIf='sortEditorOpen', (keydown.escape)='cancelSortEditor(); $event.stopPropagation()')
        .small.text-muted.mb-2(translate) Sort rules are applied from top to bottom. Folders stay first.
        .sort-rule.d-flex.align-items-center.mb-2(*ngFor='let rule of sortDraft; let index = index')
            span.me-2 {{index + 1}}.
            select.form-control.form-control-sm.me-2(
                [ngModel]='rule.field',
                (ngModelChange)='setSortField(index, $event)',
                [attr.aria-label]='("Sort field" | translate) + " " + (index + 1)'
            )
                option(value='name', [disabled]='isSortFieldUsed("name", index)', translate) Name
                option(value='modified', [disabled]='isSortFieldUsed("modified", index)', translate) Modified
                option(value='size', [disabled]='isSortFieldUsed("size", index)', translate) Size
                option(value='type', [disabled]='isSortFieldUsed("type", index)', translate) Type
            select.form-control.form-control-sm.me-2(
                [(ngModel)]='rule.direction',
                [attr.aria-label]='("Sort direction" | translate) + " " + (index + 1)'
            )
                option(value='asc', translate) Ascending
                option(value='desc', translate) Descending
            button.btn.btn-link.btn-sm(type='button', (click)='moveSortRule(index, -1)', [disabled]='index === 0', [attr.aria-label]='"Move up" | translate', [title]='"Move up" | translate')
                i.fas.fa-arrow-up(aria-hidden='true')
            button.btn.btn-link.btn-sm(type='button', (click)='moveSortRule(index, 1)', [disabled]='index === sortDraft.length - 1', [attr.aria-label]='"Move down" | translate', [title]='"Move down" | translate')
                i.fas.fa-arrow-down(aria-hidden='true')
            button.btn.btn-link.btn-sm(type='button', (click)='removeSortRule(index)', [disabled]='sortDraft.length === 1', [attr.aria-label]='"Remove sort rule" | translate', [title]='"Remove sort rule" | translate')
                i.fas.fa-times(aria-hidden='true')
        .d-flex.align-items-center.flex-wrap
            button.btn.btn-link.btn-sm.me-auto(type='button', (click)='addSortRule()', [disabled]='sortDraft.length === sortFields.length', translate) Add sort field
            button.btn.btn-secondary.btn-sm.me-2(type='button', (click)='cancelSortEditor()', translate) Cancel
            button.btn.btn-primary.btn-sm(type='button', (click)='applySort()', translate) Apply

.filter-bar.px-3.py-2.border-bottom(*ngIf='showFilter')
    .input-group
        input.form-control(
            type='text',
            placeholder='Filter...',
            autofocus,
            [(ngModel)]='filterText',
            (input)='onFilterChange()',
            (keydown.escape)='clearFilter()'
        )
        button.btn.btn-secondary((click)='clearFilter()')
            i.fas.fa-times

.body(dropZone, (transfer)='uploadOneFolder($event)')
    a.alert.alert-info.d-flex.align-items-center(
        *ngIf='shouldShowCWDTip && !cwdDetectionAvailable',
        (click)='platform.openExternal("https://tabby.sh/go/cwd-detection")'
    )
        .me-auto
            strong(translate) Working directory detection
            div(translate) Learn how to allow Tabby to detect remote shell's working directory.
        button.close((click)='dismissCWDTip()')
            i.fas.fa-close

    div(*ngIf='!sftp', translate) Connecting
    div(*ngIf='sftp')
        div(*ngIf='fileList === null', translate) Loading
        .file-table-scroll(*ngIf='fileList !== null')
            table.file-table
                caption.visually-hidden(translate) Click a column to sort. Shift-click to add or change a secondary rule. Folders stay first.
                thead
                    tr
                        th(*ngFor='let column of sortColumns', scope='col', [attr.aria-sort]='sortPriority(column.field) === 1 ? (sortDirection(column.field) === "asc" ? "ascending" : "descending") : null')
                            button.sort-heading(type='button', (click)='sortColumn(column.field, $event)', (keydown)='sortColumnKeydown(column.field, $event)', [title]='"Shift-click to add or change a secondary sort rule" | translate')
                                span {{column.label | translate}}
                                span.sort-indicator(*ngIf='sortPriority(column.field)', aria-hidden='true') {{sortDirection(column.field) === 'asc' ? '↑' : '↓'}}{{sortPriority(column.field)}}
                                span.visually-hidden(*ngIf='sortPriority(column.field)') {{sortPriority(column.field)}} {{(sortDirection(column.field) === 'asc' ? 'Ascending' : 'Descending') | translate}}
                tbody
                    tr.parent-row(*ngIf='path !== "/"', (click)='goUp()')
                        td
                            button.file-name(type='button', (click)='$event.stopPropagation(); goUp()')
                                i.fas.fa-fw.fa-level-up-alt(aria-hidden='true')
                                span(translate) Go up
                        td
                        td
                        td
                    tr.file-row(*ngFor='let item of filteredFileList', (contextmenu)='showContextMenu(item, $event)', (click)='open(item)', [title]='getModeString(item)')
                        td
                            button.file-name(type='button', (click)='$event.stopPropagation(); open(item)')
                                i.fa-fw([class]='getIcon(item)', aria-hidden='true')
                                span {{item.name}}
                        td.size
                            span(*ngIf='!item.isDirectory') {{item.size|filesize}}
                        td.type {{fileType(item) | translate}}
                        td.date {{item.modified|tabbyDate}}
        .alert.alert-info.text-center.mt-3(*ngIf='fileList !== null && filteredFileList.length === 0 && showFilter && filterText.trim() !== ""')
            i.fas.fa-search.me-2
            span(translate) No files match the filter "{{filterText}}"
